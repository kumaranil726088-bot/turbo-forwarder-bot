API_ID=1234567
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here
OWNER_ID=8841527686
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key unchanged, otherwise saved Telegram sessions cannot be decrypted.
SESSION_KEY=
PORT=8080
DB_PATH=botdata.db
DOWNLOAD_DIR=downloads
# Set to 1 ONLY when DB_PATH actually points to persistent storage.
PERSISTENT_STORAGE=0
GLOBAL_TRANSFERS=2
MAX_SESSIONS=20
MAX_FILE_MB=1900
DISK_BUDGET_MB=3000
# Optional home-DC hint if Telegram bot authorization fails on the default DC.
# Example for a bot verified to belong to DC5:
# BOT_DC_ID=5
# BOT_DC_IP=91.108.56.130
# RUN_TRANSPORT_SELFTEST=1

# OPTIONAL: private encrypted remote recovery for small deployments.
# The state repo must be PRIVATE and initialized from a validated backup before boot.
# These values belong only in the hosting environment, never commit real keys.
STATE_REPO_SSH=
STATE_BRANCH=main
STATE_SSH_KEY=
STATE_KNOWN_HOSTS=
# Routine progress checkpoints; login and important mutation requests attempt immediate sync.
STATE_SYNC_SECONDS=300

# Allow previous Render instance to retire before restoring account auth keys.
SESSION_HANDOFF_SECONDS=45
